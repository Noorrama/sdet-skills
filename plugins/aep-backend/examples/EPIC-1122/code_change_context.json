{
  "epic_id": "EPIC-1122",
  "mr_ids": ["MR-STORY-1233", "MR-STORY-1234", "MR-STORY-1235"],
  "extraction_date": "2026-08-06",
  "new_endpoints": [
    {
      "method": "POST",
      "route": "/payment/v1/cards",
      "service": "wallet-service",
      "controller_class": "PaymentController",
      "controller_method": "saveCard",
      "service_class": "CardService",
      "service_method": "saveCard",
      "repository_class": "CardRepository",
      "request_type": "CardDto",
      "response_type": "TokenResponse",
      "introduced_in_story": "STORY-1234/STORY-1235"
    }
  ],
  "changed_endpoints": [],
  "validation_rules": [
    {
      "field": "cardNumber",
      "rule": "Required; 13-19 digits; passes Luhn algorithm",
      "error_code": "MISSING_FIELD",
      "http_status": 400,
      "class": "CardValidationService",
      "story_ref": "STORY-1234"
    },
    {
      "field": "expiryMonth",
      "rule": "Required; integer 1-12",
      "error_code": "MISSING_FIELD",
      "http_status": 400,
      "class": "CardValidationService",
      "story_ref": "STORY-1234"
    },
    {
      "field": "expiryYear",
      "rule": "Required; 4-digit calendar year",
      "error_code": "MISSING_FIELD",
      "http_status": 400,
      "class": "CardValidationService",
      "story_ref": "STORY-1234"
    },
    {
      "field": "cvv",
      "rule": "Required; 3-4 digits",
      "error_code": "MISSING_FIELD",
      "http_status": 400,
      "class": "CardValidationService",
      "story_ref": "STORY-1234"
    },
    {
      "field": "expiryYear+expiryMonth",
      "rule": "expiryYear < currentYear OR (expiryYear == currentYear AND expiryMonth < currentMonth)",
      "error_code": "INVALID_EXPIRY",
      "http_status": 400,
      "class": "CardValidationService",
      "story_ref": "STORY-1234"
    }
  ],
  "error_mappings": [
    {"error_code": "MISSING_FIELD",       "http_status": 400, "condition": "Required field absent or cardNumber format invalid"},
    {"error_code": "INVALID_EXPIRY",      "http_status": 400, "condition": "Card expiry date is in the past"},
    {"error_code": "DUPLICATE_CARD",      "http_status": 409, "condition": "SHA-256 fingerprint already saved for this customer"},
    {"error_code": "SERVICE_UNAVAILABLE", "http_status": 503, "condition": "Vault service unavailable or timed out after 5000ms"}
  ],
  "db_changes": [
    {
      "migration": "V001__create_payment_cards.sql",
      "table": "payment_cards",
      "type": "CREATE_TABLE",
      "columns": [
        "id UUID PK auto-generated",
        "customer_id VARCHAR(64) NOT NULL indexed",
        "fingerprint VARCHAR(64) NOT NULL",
        "token VARCHAR(128) NOT NULL",
        "created_at TIMESTAMP NOT NULL default NOW()"
      ],
      "constraints": ["UNIQUE (customer_id, fingerprint)"],
      "rollback": "DROP TABLE payment_cards"
    }
  ],
  "new_enums": [],
  "dependency_changes": [
    {
      "service": "vault-service",
      "type": "downstream_call",
      "endpoint": "POST /vault/v1/tokenise",
      "call_class": "VaultClient",
      "call_method": "tokenise",
      "request_body": {"cardNumber": "string"},
      "success_response": {"token": "string"},
      "timeout_ms": 5000,
      "retry_count": 1,
      "failure_response": {"error": "SERVICE_UNAVAILABLE"},
      "failure_http_status": 503,
      "no_db_write_on_failure": true
    }
  ],
  "auth_changes": [
    {
      "header": "Authorization",
      "type": "Bearer",
      "required": true,
      "header_name": "Client-ID",
      "notes": "Service client identifier; also required"
    }
  ],
  "feature_flags": [
    {
      "flag": "payment.card_save.enabled",
