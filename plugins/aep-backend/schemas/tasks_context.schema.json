          "type": "integer"
        },
        "blocked_tasks": {
          "type": "integer"
        },
        "open_questions": {
          "type": "integer"
        },
        "by_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_service": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_test_layer": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_team": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "unresolved_teams": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Team names that did not resolve in team_registry.json. Never silently dropped."
    },
    "extraction_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "missing_from_source",
              "contract_incomplete",
              "ambiguous",
              "not_reconciled",
              "flag_underspecified",
              "missing_timeline"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "field",
          "reason"
        ]
      },
      "description": "What the source did not say, recorded instead of guessed. blocking:true means downstream must not proceed on that field."
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions_unmapped": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Question ids whose blocks[] targets are absent from this file's epics — typically referencing tasks in another epic."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
