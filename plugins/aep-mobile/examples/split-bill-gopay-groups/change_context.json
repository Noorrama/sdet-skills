  "cr_risks": [
    {
      "id": "CR-1",
      "area": "SELECT_MEMBER_PAGE",
      "category": "concurrency",
      "linked_risk": "R1",
      "suggested_test": "Loader is shown during slow group-member fetch while selecting members",
      "severity": "High",
      "disposition": "becomes-scenario",
      "note": "group_info_loader element exists and is bindable, but the manifest shows no state-injection hook to deterministically force the slow-fetch race; resolved-state rule (OQ5) is still open."
    },
    {
      "id": "CR-2",
      "area": "SELECT_MEMBER_PAGE",
      "category": "reliability",
      "linked_risk": "R2",
      "suggested_test": "Backgrounding the select-member screen does not cancel queued invites",
      "severity": "High",
      "disposition": "becomes-scenario",
      "note": "invite_toggle and POST /gopay/groups/{groupId}/invite (INVITE_FAILED) are present, but fire-and-forget/queue-survival behavior on screen dismissal is not observable from the manifest alone and needs runtime verification."
    },
    {
      "id": "CR-3",
      "area": "SELECT_MEMBER_PAGE",
      "category": "locator-gap",
      "linked_risk": "R5",
      "suggested_test": "Group member threshold boundary at 24, 25, and 26 members",
      "severity": "Medium",
      "disposition": "becomes-bug",
      "note": "group_picker_list has one locator for the whole list; no distinct locator/state was declared for a disabled (>25-member) list item, needed to assert the disabled-selection behavior at the element level."
    },
    {
      "id": "CR-4",
      "area": "SELECT_MEMBER_PAGE",
      "category": "locator-gap",
      "linked_risk": "R6",
      "suggested_test": "Selecting a second group is blocked with a toast",
      "severity": "Medium",
      "disposition": "becomes-bug",
      "note": "No locator was declared for the 'can't select 2 groups' toast; without a stable ID, this scenario can only assert on transient system-toast text."
    },
    {
      "id": "CR-5",
      "area": "SELECT_MEMBER_PAGE",
      "category": "logic-verification",
      "linked_risk": "R8",
      "suggested_test": "Recommendation API error is suppressed when a group is already selected",
      "severity": "Medium",
      "disposition": "acknowledged",
      "note": "recommendation_error_banner element exists, but the show/hide-per-selected-group suppression rule is business logic not visible from locators alone; needs functional verification against the documented rule."
    }
  ],
