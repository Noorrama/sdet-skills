{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prd_context",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "feature_key", "module_namespace", "business_requirements"],
  "properties": {
    "extraction_status": { "type": "string", "enum": ["OK", "INCOMPLETE", "DEGRADED"], "description": "OK = every field resolved from the inputs. INCOMPLETE = one or more fields could not be resolved and were left absent. DEGRADED = a config/schema/tool the skill depends on was unavailable. Never OK when extraction_gaps is non-empty." },
    "extraction_gaps": {
      "type": "array",
      "description": "Everything the skill could NOT resolve, written instead of guessing a value. Empty array = clean extraction.",
      "items": {
        "type": "object",
        "required": ["field", "reason", "severity"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "description": "JSON path of the unresolved field, e.g. business_requirements[3].target_module. Use 'ENVIRONMENT' for install/tool failures not tied to one field." },
          "reason": { "type": "string", "description": "Why it could not be resolved, citing the source section checked." },
          "action": { "type": "string", "description": "What a human must do to close the gap." },
          "severity": { "type": "string", "enum": ["BLOCKING", "DEGRADED", "INFO"], "description": "BLOCKING = schema-required field absent. DEGRADED = resolved without normal grounding. INFO = optional content genuinely absent from the source." }
        }
      }
    },
    "app": { "type": "string", "description": "app_id from the per-app config" },
    "feature_key": { "type": "string" },
    "module_namespace": {
      "type": "array",
      "items": { "type": "string" }
    },
    "business_requirements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["req_id", "target_module", "user_story"],
        "properties": {
          "req_id": { "type": "string" },
          "milestone": { "type": "string" },
          "target_module": { "type": "string" },
          "user_story": { "type": "string" },
          "context_screen": { "type": "string" },
          "expected_ui_copy": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "screen": { "type": "string" },
                "ui_copy": { "type": "string" }
              }
            }
          },
          "target_personas": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "prerequisites": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "boundary_conditions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "req_id": { "type": "string" },
          "edge_case_description": { "type": "string" },
          "proposed_default": { "type": "string" }
        }
      }
    },
    "applicable_countries": { "type": "array", "items": { "type": "string" } },
    "applicable_platforms": { "type": "array", "items": { "type": "string" } },
    "applicable_service_types": { "type": "array", "items": { "type": "string" } },
    "out_of_scope_module": { "type": "array", "items": { "type": "string" } },
    "rollout_plan": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "user_segment": { "type": "string" },
        "timeline": { "type": "string" }
      }
    },
    "feature_flags": { "type": "array", "items": { "type": "string" } }
  }
}