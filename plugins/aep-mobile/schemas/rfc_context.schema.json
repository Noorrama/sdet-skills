{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rfc_context",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "scope"],
  "properties": {
    "app": { "type": "string" },
    "scope": { "type": "string" },
    "risk_areas": { "type": "array", "items": { "type": "string" } },
    "risk_register": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "area"],
        "properties": {
          "id": { "type": "string" },
          "area": { "type": "string" },
          "severity": { "type": "string" },
          "likelihood": { "type": "string" },
          "test_focus": { "type": "string" },
          "p0": { "type": "boolean" }
        }
      }
    },
    "feature_flags": {
      "type": "array",
      "items": { "type": "object",
        "properties": { "key": { "type": "string" }, "states": { "type": "array", "items": { "type": "string" } } } }
    },
    "cross_team_deps": { "type": "array", "items": { "type": "string" } },
    "min_app_version": { "type": "string" },
    "n1_compat": { "type": "string", "description": "backward-compat note for N-1 app version" },
    "rollout": { "type": "string" }
  }
}
