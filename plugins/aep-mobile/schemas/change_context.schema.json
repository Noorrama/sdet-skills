{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "change_context (post-build; from the MR)",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "epic_ref", "changed_screens", "elements"],
  "properties": {
    "app": { "type": "string" },
    "epic_ref": { "type": "string", "description": "JIRA/EPIC key linking the MR(s)" },
    "merge_requests": { "type": "array", "items": { "type": "string" }, "description": "MR iids unioned for this EPIC" },
    "changed_screens": { "type": "array", "items": { "type": "string" } },
    "elements": {
      "type": "array",
      "description": "logical element_id → real per-platform locators (both platforms)",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["element_id"],
        "properties": {
          "element_id": { "type": "string" },
          "android_locator": { "type": "string", "description": "resource-id" },
          "ios_locator": { "type": "string", "description": "accessibilityId" }
        }
      }
    },
    "routes": { "type": "array", "items": { "type": "string" }, "description": "new/changed deeplinks or routes" },
    "api": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "endpoint": { "type": "string" },
          "request": { "type": "string" },
          "response": { "type": "string" },
          "error_codes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "flags": { "type": "array", "items": { "type": "string" } },
    "analytics": { "type": "array", "items": { "type": "string" } },
    "app_api_version": { "type": "string", "description": "app <-> service version, incl. N-1" },
    "cr_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "area": { "type": "string" },
          "category": { "type": "string" },
          "suggested_test": { "type": "string" },
          "severity": { "type": "string" },
          "disposition": { "type": "string", "enum": ["becomes-scenario", "becomes-bug", "acknowledged"] }
        }
      }
    }
  }
}
