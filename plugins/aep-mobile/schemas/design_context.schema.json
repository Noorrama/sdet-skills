{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "extraction_status": { "type": "string", "enum": ["OK", "INCOMPLETE", "DEGRADED"], "description": "OK = every field resolved from the inputs. INCOMPLETE = one or more fields could not be resolved and were left absent. DEGRADED = a config/schema/tool the skill depends on was unavailable. Never OK when extraction_gaps is non-empty." },
    "extraction_gaps": {
      "type": "array",
      "description": "Everything the skill could NOT resolve, written instead of guessing a value. Empty array = clean extraction.",
      "items": {
        "type": "object",
        "required": ["field", "reason", "severity"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "description": "JSON path of the unresolved field, e.g. business_requirements[3].target_module. Use 'ENVIRONMENT' for install/tool failures not tied to one field." },
          "reason": { "type": "string", "description": "Why it could not be resolved, citing the source section checked." },
          "action": { "type": "string", "description": "What a human must do to close the gap." },
          "severity": { "type": "string", "enum": ["BLOCKING", "DEGRADED", "INFO"], "description": "BLOCKING = schema-required field absent. DEGRADED = resolved without normal grounding. INFO = optional content genuinely absent from the source." }
        }
      }
    },
    "visual_analysis_scratchpad": {
      "type": "string",
      "description": "Write a 2-3 sentence overview of what you visually detect in the image before compiling the technical fields. List screens found."
    },
    "project_context": {
      "type": "object",
      "properties": {
        "overall_ambiguity_rating": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "blocking_issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["overall_ambiguity_rating", "blocking_issues"]
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "screen_id": { 
            "type": "string",
            "pattern": "^[A-Z0-9_]+$",
            "description": "Figma frame title forced into UPPER_SNAKE_CASE (e.g., LOGIN_SCREEN)"
          },
          "screen_name": { "type": "string" },
          "purpose": { "type": "string" },
          "screen_states": {
            "type": "array",
            "items": { "type": "string" }
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "element_id": { 
                  "type": "string",
                  "pattern": "^[A-Z0-9_]+\\.[A-Z0-9_]+(\\.[A-Z0-9_]+)?$",
                  "description": "Syntax: <SCREEN_ID>.<ACTION>_<ELEMENT_TYPE>.<STATE> all in UPPER_SNAKE_CASE (e.g., LOGIN_SCREEN.TAP_BUTTON.DISABLED)"
                },
                "type": { "type": "string" },
                "label": { "type": "string" },
                "states_represented": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "interactions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "trigger": { "type": "string" },
                      "action": { "type": "string" }
                    },
                    "required": ["trigger", "action"]
                  }
                },
                "validations_and_edge_cases": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["element_id", "type", "label", "states_represented", "interactions", "validations_and_edge_cases"]
            }
          },
          "screen_notes": { "type": "string" }
        },
        "required": ["screen_id", "screen_name", "purpose", "screen_states", "elements", "screen_notes"]
      }
    },
    "ui_flow": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_screen_id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "trigger_element_id": { "type": "string", "pattern": "^[A-Z0-9_]+\\.[A-Z0-9_]+(\\.[A-Z0-9_]+)?$" },
          "to_screen_id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "condition": { "type": "string" }
        },
        "required": ["from_screen_id", "trigger_element_id", "to_screen_id", "condition"]
      }
    }
  },
  "required": ["visual_analysis_scratchpad", "project_context", "screens", "ui_flow"]
}
