{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDETPlanMasterOutputSchema",
  "type": "object",
  "properties": {
    "extraction_status": { "type": "string", "enum": ["OK", "INCOMPLETE", "DEGRADED"], "description": "OK = every field resolved from the inputs. INCOMPLETE = one or more fields could not be resolved and were left absent. DEGRADED = a config/schema/tool the skill depends on was unavailable. Never OK when extraction_gaps is non-empty." },
    "extraction_gaps": {
      "type": "array",
      "description": "Everything the skill could NOT resolve, written instead of guessing a value. Empty array = clean extraction.",
      "items": {
        "type": "object",
        "required": ["field", "reason", "severity"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "description": "JSON path of the unresolved field, e.g. business_requirements[3].target_module. Use 'ENVIRONMENT' for install/tool failures not tied to one field." },
          "reason": { "type": "string", "description": "Why it could not be resolved, citing the source section checked." },
          "action": { "type": "string", "description": "What a human must do to close the gap." },
          "severity": { "type": "string", "enum": ["BLOCKING", "DEGRADED", "INFO"], "description": "BLOCKING = schema-required field absent. DEGRADED = resolved without normal grounding. INFO = optional content genuinely absent from the source." }
        }
      }
    },
    "version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "feature_metadata": {
      "type": "object",
      "properties": {
        "feature_key": { "type": "string" },
        "module_namespace": { "type": "string" }
      },
      "required": ["feature_key", "module_namespace"],
      "additionalProperties": false
    },
    "scope_summary": { "type": "string" },
    "risk_assessment": {
      "type": "array",
      "items": { "type": "string" }
    },
    "environments": {
      "type": "array",
      "items": { "type": "string", "enum": ["QA", "Prod"] },
      "minItems": 1
    },
    "coverage_categories": {
      "type": "object",
      "description": "Output of the Test-Category Selection Gate (Step 0). auto_selected is the mandatory signal-derived baseline; optional_extras are QA-discretionary.",
      "properties": {
        "auto_selected": {
          "type": "array",
          "description": "Categories whose detection signal fired in the supplied contexts. Always generated.",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "reason": { "type": "string", "description": "The exact input field that fired, e.g. rfc.lifecycle_considerations[0].event = PROCESS_DEATH" }
            },
            "required": ["category", "reason"],
            "additionalProperties": false
          }
        },
        "optional_extras_available": {
          "type": "object",
          "properties": {
            "feature_adjacent": {
              "type": "array",
              "description": "Categories whose trigger field exists in the schema but was empty/absent for this feature.",
              "items": {
                "type": "object",
                "properties": {
                  "category": { "type": "string" },
                  "rationale": { "type": "string" }
                },
                "required": ["category", "rationale"],
                "additionalProperties": false
              }
            },
            "fe_baseline": {
              "type": "array",
              "description": "Universal FE-mobile hygiene categories not derivable from the docs, gated by an applicability predicate.",
              "items": {
                "type": "object",
                "properties": {
                  "group": { "type": "string" },
                  "category": { "type": "string" },
                  "rationale": { "type": "string" },
                  "applicability": { "type": "string" },
                  "source": { "type": "string", "enum": ["fe_baseline"] }
                },
                "required": ["group", "category", "rationale"],
                "additionalProperties": false
              }
            }
          },
          "required": ["feature_adjacent", "fe_baseline"],
          "additionalProperties": false
        },
        "optional_extras_selected": {
          "type": "array",
          "items": { "type": "string" }
        },
        "user_removed": {
          "type": "array",
          "description": "AUTO categories the QA explicitly overrode out of scope, with reason.",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "reason": { "type": "string" }
            },
            "required": ["category", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["auto_selected", "optional_extras_available"],
      "additionalProperties": false
    },
    "scenario_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "csv_title_association": { "type": "string" },
          "requirement_ref": { "type": "string" },
          "priority_tier": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "execution_scope": {
            "type": "string",
            "enum": ["FRONTEND_ONLY", "BACKEND_ONLY", "END_TO_END"]
          },
          "is_legacy_regression": { "type": "boolean" },
          "automatable": { "type": "boolean" },
          "target_execution_framework": {
            "type": "string",
            "enum": ["TAPMIND_NLP", "GMT_JAVA"]
          },
          "test_case_type": { "type": "string" },
          "automation_status": { "type": "string" },
          "coverage_category": {
            "type": "string",
            "description": "Which Category Catalog category this scenario belongs to (e.g. boundary, interruption_network, session_auth)."
          },
          "source": {
            "type": "string",
            "enum": ["input_derived", "feature_adjacent", "fe_baseline", "qa_added"],
            "description": "Provenance of the scenario. fe_baseline/qa_added are curated hygiene, NOT input-derived requirements."
          },
          "steps": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Supports automated execution steps and manual/legacy regression test steps."
          },
          "expected_result": { "type": "string" },
          "execution_mode": { "type": "string" },
          "platform": { "type": "string" },
          "country": { "type": "string" },
          "driver_type": { "type": "string" },
          "preconditions_metadata": {
            "type": "object",
            "properties": {
              "target_environment": { "type": "string", "enum": ["QA", "Prod"] },
              "target_locale": { "type": "string" },
              "active_experiment_flags": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "target_entry_deeplink": { "type": "string" }
            },
            "required": ["target_environment", "target_locale"],
            "additionalProperties": false
          },
          "mapped_user_flow": {
            "type": "object",
            "properties": {
              "origin_screen": { "type": "string" },
              "trigger_action": { "type": "string" },
              "destination_screen": { "type": "string" },
              "transition_style": { "type": "string" }
            },
            "required": ["origin_screen", "trigger_action", "destination_screen"],
            "additionalProperties": false
          },
          "clickstream_events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_name": { "type": "string" },
                "trigger_condition": { "type": "string" },
                "required_attributes": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              },
              "required": ["event_name", "trigger_condition", "required_attributes"],
              "additionalProperties": false
            },
            "description": "Clickstream/analytics telemetry specs extracted from prd-extractor."
          },
          "test_data_tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": [
          "csv_title_association",
          "requirement_ref",
          "priority_tier",
          "execution_scope",
          "is_legacy_regression",
          "automatable",
          "target_execution_framework",
          "test_case_type",
          "automation_status",
          "steps",
          "expected_result",
          "execution_mode",
          "preconditions_metadata",
          "mapped_user_flow",
          "test_data_tags"
        ],
        "additionalProperties": false
      }
    },
    "cross_stage_gap_analysis": {
      "type": "object",
      "properties": {
        "prd_vs_figma_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_id": { "type": "string" },
              "severity": { "type": "string", "enum": ["CRITICAL_BLOCKER", "WARNING"] },
              "gap_description": { "type": "string" }
            },
            "required": ["requirement_id", "severity", "gap_description"],
            "additionalProperties": false
          }
        },
        "prd_vs_rfc_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_id": { "type": "string" },
              "gap_description": { "type": "string" }
            },
            "required": ["requirement_id", "gap_description"],
            "additionalProperties": false
          }
        },
        "rfc_vs_impl_plan_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rfc_id": { "type": "string" },
              "gap_description": { "type": "string" }
            },
            "required": ["rfc_id", "gap_description"],
            "additionalProperties": false
          }
        }
      },
      "required": ["prd_vs_figma_gaps", "prd_vs_rfc_gaps", "rfc_vs_impl_plan_gaps"],
      "additionalProperties": false
    },
    "testability_feedback": {
      "type": "object",
      "properties": {
        "missing_hooks": { "type": "array", "items": { "type": "string" } },
        "locator_readiness_checklist": { "type": "array", "items": { "type": "string" } },
        "unclear_ac": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["missing_hooks", "locator_readiness_checklist", "unclear_ac"],
      "additionalProperties": false
    },
    "element_locator_handoff": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "screen_id": { "type": "string" },
          "element_role": { "type": "string" },
          "generated_logical_id": { "type": "string" },
          "accessibility_mapping_directives": {
            "type": "object",
            "properties": {
              "android_resource_id": { "type": "string" },
              "ios_accessibility_identifier": { "type": "string" },
              "flutter_key": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "screen_id",
          "element_role",
          "generated_logical_id",
          "accessibility_mapping_directives"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "created_at",
    "updated_at",
    "feature_metadata",
    "scope_summary",
    "risk_assessment",
    "environments",
    "scenario_list",
    "cross_stage_gap_analysis",
    "testability_feedback",
    "element_locator_handoff"
  ],
  "additionalProperties": false
}