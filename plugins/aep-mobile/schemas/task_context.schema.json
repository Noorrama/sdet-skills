{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "task_context (PRIMARY DRIVER)",
  "description": "Normalized task-generation tree (milestones + epics → user_stories → tasks) plus the feature-level test hooks/screens/flags and per-task observable state the SDET_PLAN relies on. Produced by task-extractor from task_input.json (RFC §2.4), consumed by sdet-plan-generator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "epics"],
  "properties": {
    "app": { "type": "string", "description": "app_id from config/<app>.json." },
    "extracted_at": { "type": "string", "description": "ISO-8601 timestamp." },
    "extractor_version": { "type": "string" },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prd_url": { "type": "string" },
        "rfc_url": { "type": "string" },
        "design_url": { "type": "string" }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["milestone_id", "name"],
        "properties": {
          "milestone_id": { "type": "string" },
          "name": { "type": "string" },
          "target_date": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["epic_id", "title", "user_stories"],
        "properties": {
          "epic_id": { "type": "string" },
          "title": { "type": "string" },
          "goal": { "type": "string" },
          "milestone_id": { "type": "string" },
          "user_stories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["user_story_id", "title", "tasks"],
              "properties": {
                "user_story_id": { "type": "string" },
                "title": { "type": "string" },
                "requirement_id": { "type": "string", "description": "PRD business_requirements[].req_id." },
                "acceptance_criteria": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["acceptance_criteria_id", "description"],
                    "properties": {
                      "acceptance_criteria_id": { "type": "string" },
                      "description": { "type": "string" }
                    }
                  }
                },
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["task_id", "title", "issue_type", "track"],
                    "properties": {
                      "task_id": { "type": "string" },
                      "title": { "type": "string" },
                      "issue_type": { "type": "string", "enum": ["Task", "Sub-task", "Bug", "Spike"] },
                      "track": { "type": "string", "enum": ["android", "ios", "flutter", "backend", "design", "qa", "infra", "other"] },
                      "deep_link": { "type": "string", "description": "Routing entry point that reaches the touched screen (RFC §2.4)." },
                      "observable_state": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "success_signal": { "type": "string" },
                          "failure_signal": { "type": "string" }
                        }
                      },
                      "dependencies": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["type", "task_id"],
                          "properties": {
                            "type": { "type": "string", "enum": ["blocks", "is-blocked-by", "relates-to"] },
                            "task_id": { "type": "string" }
                          }
                        }
                      },
                      "mr_refs": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["url"],
                          "properties": {
                            "url": { "type": "string" },
                            "platform": { "type": "string", "enum": ["android", "ios", "flutter", "backend"] }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "change_summary": { "type": "string" },
          "target_modules": { "type": "array", "items": { "type": "string" } },
          "screens_touched": { "type": "array", "items": { "type": "string" }, "description": "screen_ids" },
          "view_models": { "type": "array", "items": { "type": "string" } },
          "new_components": {
            "type": "array",
            "items": { "type": "object", "properties": { "name": { "type": "string" }, "purpose": { "type": "string" } } }
          },
          "flag_keys": {
            "type": "array",
            "items": { "type": "object",
              "properties": { "key": { "type": "string" }, "default": { "type": "string" } } }
          },
          "test_hooks": {
            "type": "array",
            "description": "how QA reaches/sets up a screen without full UI walk",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["hook_id", "type", "invoke"],
              "properties": {
                "hook_id": { "type": "string" },
                "type": { "type": "string", "enum": ["deeplink", "flag-override", "state-injection"] },
                "target": { "type": "string", "description": "screen_id / element_id it reaches or sets" },
                "invoke": { "type": "string", "description": "the deeplink URI / how to set the flag / how to inject state" }
              }
            }
          },
          "testability_gaps": { "type": "array", "items": { "type": "string" }, "description": "P0 flows with no deep link / observable state, or unlisted flags." }
        }
      }
    },

    "traceability": {
      "type": "array",
      "description": "Maps each task to the requirement/AC it satisfies and the screens it touches.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id"],
        "properties": {
          "task_id": { "type": "string" },
          "user_story_id": { "type": "string" },
          "requirement_id": { "type": "string", "description": "PRD req_id (via the parent story)." },
          "acceptance_criteria_ids": { "type": "array", "items": { "type": "string" } },
          "screen_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "blocking_dependencies": {
      "type": "array",
      "description": "Cross-track blocking edges rolled up for QA sequencing (e.g. a mobile task blocked by a backend task).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocked", "blocked_by"],
        "properties": {
          "blocked": { "type": "string", "description": "task_id that is blocked" },
          "blocked_by": { "type": "string", "description": "task_id that blocks it" },
          "blocked_track": { "type": "string" },
          "blocked_by_track": { "type": "string" }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_epics": { "type": "integer" },
        "total_stories": { "type": "integer" },
        "total_tasks": { "type": "integer" },
        "by_type": { "type": "object", "additionalProperties": { "type": "integer" } },
        "by_track": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "blocking_issues": { "type": "array", "items": { "type": "string" } }
  }
}
