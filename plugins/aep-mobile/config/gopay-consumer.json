    { "os": "android", "version": "11", "device": "Galaxy A52" },
    { "os": "ios", "version": "17", "device": "iPhone 14" }
  ],
  "testbuddy": {
    "agents": ["CustomerAgent", "PaymentAgent", "VoucherAgent"],
    "segments": {
      "kyc_verified": "<TODO: TestBuddy segment/tag>",
      "kyc_unverified": "<TODO>",
      "wallet_near_limit": "<TODO>"
    }
  },
  "default_output": "NLP"
}
